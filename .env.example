# ─────────────────────────────────────────────────────────
# Futebol Elite — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# Tudo aqui é opcional: sem .env o sistema roda 100% offline.
# ─────────────────────────────────────────────────────────

# ── APIs de Dados ──────────────────────────────────────
# API Futebol (https://api-futebol.com.br) — dados BR nativos
API_FUTEBOL_KEY=

# Football-Data.org (https://www.football-data.org) — fallback global
FOOTBALL_DATA_KEY=

# Timeout (s) e número de novas tentativas das chamadas HTTP externas
HTTP_TIMEOUT=10
HTTP_RETRIES=2

# ── Banco de Dados ─────────────────────────────────────
# SQLite (padrão — desenvolvimento local):
DATABASE_URL=sqlite:///./futebol_elite.db

# PostgreSQL (produção) — exige psycopg2-binary, já em requirements.txt:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/futebol_elite

# true para logar todo SQL emitido (debug)
DB_ECHO=false

# ── API REST ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# URL que o dashboard e o bot usam para falar com a API.
# No Docker Compose precisa ser o nome do serviço, não 127.0.0.1.
API_BASE_URL=http://127.0.0.1:8000

# Origens permitidas no CORS, separadas por vírgula.
# O padrão "*" é aberto; em produção liste os domínios reais.
CORS_ORIGINS=*
# Só tem efeito quando CORS_ORIGINS não é "*" (regra do navegador).
CORS_ALLOW_CREDENTIALS=false

# ── Cache ──────────────────────────────────────────────
# Tempo de vida do cache local em horas (padrão: 6)
CACHE_TTL_HOURS=6

# Onde ficam cache e resultados do bot
# DATA_DIR=./data

# ── Bot / Agendador ────────────────────────────────────
# Horários da análise diária (HH:MM, separados por vírgula)
BOT_SCHEDULE_TIMES=09:00,18:00
# Roda uma análise assim que o worker sobe
BOT_RUN_ON_START=true
# Quantos arquivos de resultado manter em data/ (0 = nunca limpar)
BOT_KEEP_RESULTS=30

# ── Campeonato padrão ──────────────────────────────────
# 10 = Brasileirão Série A na API Futebol
CAMPEONATO_ID=10

# ── Ambiente ───────────────────────────────────────────
# development | production
ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
