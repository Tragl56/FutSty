# ─────────────────────────────────────────────────────────
# Futebol Elite — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# ─────────────────────────────────────────────────────────

# ── APIs de Dados ──────────────────────────────────────
# API Futebol (https://api-futebol.com.br) — dados BR nativos
API_FUTEBOL_KEY=seu_token_aqui

# Football-Data.org (https://www.football-data.org) — fallback global
FOOTBALL_DATA_KEY=seu_token_aqui

# ── Banco de Dados ─────────────────────────────────────
# SQLite (padrão — desenvolvimento local):
DATABASE_URL=sqlite:///./futebol_elite.db

# PostgreSQL (produção):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/futebol_elite

# ── API REST ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Cache ──────────────────────────────────────────────
# Tempo de vida do cache local em horas (padrão: 6)
CACHE_TTL_HOURS=6

# ── Ambiente ───────────────────────────────────────────
# development | production
ENV=development
